        "code": "\nimport re\n\nseq = \"\"\nwith open(\"region.fasta\") as f:\n    for line in f:\n        if line.startswith(\">\"):\n            header = line.strip()\n        else:\n            seq += line.strip()\n\nprint(\"Header:\", header)\nprint(\"Length:\", len(seq))\n\n# Nucleotide composition\nfrom collections import Counter\nc = Counter(seq)\nprint(\"Composition:\", dict(c))\ngc = (c['G']+c['C'])/len(seq)*100\nprint(\"GC%: %.1f\" % gc)\n\n# Check for non-ATGC\nprint(\"Non-ATGC chars:\", [ch for ch in c if ch not in 'ATGC'])\n\n# Codon usage / ORFs - check all 6 frames for longest ORF\ndef revcomp(s):\n    comp = {'A':'T','T':'A','C':'G','G':'C'}\n    return ''.join(comp[b] for b in reversed(s))\n\ndef translate(s):\n    code = {\n    'TTT':'F','TTC':'F','TTA':'L','TTG':'L','CTT':'L','CTC':'L','CTA':'L','CTG':'L',\n    'ATT':'I','ATC':'I','ATA':'I','ATG':'M','GTT':'V','GTC':'V','GTA':'V','GTG':'V',\n    'TCT':'S','TCC':'S','TCA':'S','TCG':'S','CCT':'P','CCC':'P','CCA':'P','CCG':'P',\n    'ACT':'T','ACC':'T','ACA':'T','ACG':'T','GCT':'A','GCC':'A','GCA':'A','GCG':'A',\n    'TAT':'Y','TAC':'Y','TAA':'*','TAG':'*','CAT':'H','CAC':'H','CAA':'Q','CAG':'Q',\n    'AAT':'N','AAC':'N','AAA':'K','AAG':'K','GAT':'D','GAC':'D','GAA':'E','GAG':'E',\n    'TGT':'C','TGC':'C','TGA':'*','TGG':'W','CGT':'R','CGC':'R','CGA':'R','CGG':'R',\n    'AGT':'S','AGC':'S','AGA':'R','AGG':'R','GGT':'G','GGC':'G','GGA':'G','GGG':'G'}\n    prot = \"\"\n    for i in range(0,len(s)-2,3):\n        prot += code.get(s[i:i+3],'X')\n    return prot\n\nframes = []\nfor strand, s in [('+', seq), ('-', revcomp(seq))]:\n    for f in range(3):\n        frames.append((strand, f, s[f:]))\n\nprint(\"\\nLongest ORFs (no stop, min 100 aa) per frame:\")\nfor strand, f, s in frames:\n    prot = translate(s)\n    # find longest stretch without stop\n    parts = prot.split('*')\n    best = max(parts, key=len)\n    if len(best) >= 30:\n        startcodon = s[:3]\n        # position in original seq\n        print(f\"strand {strand} frame {f}: {len(best)} aa, starts at seq-pos {f+1}\")\n\n"
