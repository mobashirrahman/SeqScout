        "code": "\nseq = \"\"\nwith open(\"region.fasta\") as f:\n    for line in f:\n        if line.startswith(\">\"):\n            continue\n        seq += line.strip()\n\nL = len(seq)\nprint(\"Length:\", L)\nfrom collections import Counter\nc = Counter(seq)\ngc = (c['G']+c['C'])/L*100\nprint(\"GC pct: %.1f\" % gc)\nprint(\"A:%d T:%d G:%d C:%d\" % (c['A'], c['T'], c['G'], c['C']))\n\ndef revcomp(s):\n    comp = {'A':'T','T':'A','C':'G','G':'C'}\n    return ''.join(comp[b] for b in reversed(s))\n\ndef translate(s):\n    code = {\n    'TTT':'F','TTC':'F','TTA':'L','TTG':'L','CTT':'L','CTC':'L','CTA':'L','CTG':'L',\n    'ATT':'I','ATC':'I','ATA':'I','ATG':'M','GTT':'V','GTC':'V','GTA':'V','GTG':'V',\n    'TCT':'S','TCC':'S','TCA':'S','TCG':'S','CCT':'P','CCC':'P','CCA':'P','CCG':'P',\n    'ACT':'T','ACC':'T','ACA':'T','ACG':'T','GCT':'A','GCC':'A','GCA':'A','GCG':'A',\n    'TAT':'Y','TAC':'Y','TAA':'*','TAG':'*','CAT':'H','CAC':'H','CAA':'Q','CAG':'Q',\n    'AAT':'N','AAC':'N','AAA':'K','AAG':'K','GAT':'D','GAC':'D','GAA':'E','GAG':'E',\n    'TGT':'C','TGC':'C','TGA':'*','TGG':'W','CGT':'R','CGC':'R','CGA':'R','CGG':'R',\n    'AGT':'S','AGC':'S','AGA':'R','AGG':'R','GGT':'G','GGC':'G','GGA':'G','GGG':'G'}\n    out=[]\n    for i in range(0,len(s)-2,3):\n        out.append(code.get(s[i:i+3],'X'))\n    return ''.join(out)\n\n# GC skew in 100bp windows\nprint(\"\\nGC skew (100bp windows):\")\nfor i in range(0, L, 100):\n    w = seq[i:i+100]\n    g=w.count('G'); c=w.count('C')\n    skew = (g-c)/(g+c) if (g+c)>0 else 0\n    print(\"%4d-%4d  GC=%.2f skew=%+.3f\" % (i+1, min(i+100,L), (g+c)/len(w)*100, skew))\n\n# Find all ORFs (start ATG, stop *), min length\nstops = ['TAA','TAG','TGA']\nprint(\"\\nLong ORFs (>=100 codons) across all 6 frames:\")\nfor strand, s in [('+', seq), ('-', revcomp(seq))]:\n    for fr in range(3):\n        sub = s[fr:]\n        # find start codons followed by stop\n        for m in __import__('re').finditer('ATG', sub):\n            pos = m.start()\n            # translate from pos\n            prot = translate(sub[pos:])\n            if '*' in prot:\n                end = prot.index('*')\n                aa = end\n                if aa >= 100:\n                    # coordinate on original seq\n                    if strand=='+':\n                        cstart = fr+pos+1\n                        cend = fr+pos+ end*3 +3\n                    else:\n                        cstart = L - (fr+pos) \n                        cend = L - (fr+pos+ end*3)\n                    print(\"strand %s frame %d: %d aa, %s:%d-%d\" % (strand, fr, aa, strand, cstart, cend))\n\n"
